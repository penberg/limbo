test fk-update-noaction-null-parent-key-noop {
    PRAGMA foreign_keys=ON;
    CREATE TABLE parent(k INT UNIQUE);
    CREATE TABLE child(
        id INTEGER PRIMARY KEY,
        pkey INT REFERENCES parent(k) ON UPDATE NO ACTION
    );
