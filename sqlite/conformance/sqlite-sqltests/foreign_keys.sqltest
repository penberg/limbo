# UPDATE OR REPLACE with no conflict should not affect children
@cross-check-integrity
test fk-update-or-replace-no-conflict {
    PRAGMA foreign_keys=ON;
    CREATE TABLE parent(id INTEGER PRIMARY KEY, name TEXT UNIQUE);
    CREATE TABLE child(id INTEGER PRIMARY KEY, parent_id INT REFERENCES parent(id) ON DELETE CASCADE);
    INSERT INTO parent VALUES (10, 'x'), (20, 'y');
    INSERT INTO child VALUES (10, 10), (20, 20);
    UPDATE OR REPLACE parent SET name = 'z' WHERE id = 10;
    SELECT * FROM child ORDER BY id;
}
expect {
    10|10
    20|20
}

# UPDATE OR REPLACE on rowid conflict should fire FK CASCADE on implicitly-deleted row
@cross-check-integrity
test fk-update-or-replace-cascade-on-rowid-conflict {
    PRAGMA foreign_keys=ON;
    CREATE TABLE parent(id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE child(id INTEGER PRIMARY KEY, parent_id INT REFERENCES parent(id) ON DELETE CASCADE ON UPDATE CASCADE);
    INSERT INTO parent VALUES (10, 'x'), (20, 'y');
    INSERT INTO child VALUES (1, 10), (2, 20);
    UPDATE OR REPLACE parent SET id = 20 WHERE id = 10;
    SELECT * FROM child ORDER BY id;
}
expect {
    1|20
}

# UPDATE OR REPLACE on rowid conflict should fire FK SET NULL on the
# implicitly-deleted conflicting parent row before the surviving parent row is
# updated into that key.
@cross-check-integrity
test fk-update-or-replace-set-null-on-rowid-conflict {
    PRAGMA foreign_keys=ON;
    CREATE TABLE parent(id INTEGER PRIMARY KEY, name TEXT);
    CREATE TABLE child(
        id INTEGER PRIMARY KEY,
        parent_id INT REFERENCES parent(id) ON DELETE SET NULL ON UPDATE CASCADE
    );
    INSERT INTO parent VALUES (10, 'x'), (20, 'y');
    INSERT INTO child VALUES (1, 10), (2, 20);
    UPDATE OR REPLACE parent SET id = 20 WHERE id = 10;
    SELECT * FROM child ORDER BY id;
}
expect {
    1|20
    2|
}

