test fk-self-unique-mismatch {
    PRAGMA foreign_keys=ON;
    CREATE TABLE t(
        u TEXT,
        v TEXT,
        cu TEXT,
        cv TEXT,
        UNIQUE(u,v),
        FOREIGN KEY(cu,cv) REFERENCES t(u,v)
    );
    -- Child points to a different (u,v) that doesn't exist: must fail
    INSERT INTO t(u,v,cu,cv) VALUES('A','B','A','X');
}
expect error {
