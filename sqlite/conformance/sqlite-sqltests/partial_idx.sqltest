    UPDATE t3 SET val = 20 WHERE id = 1;
    UPDATE t3 SET val = 5 WHERE id = 2;
    SELECT id, val FROM t3 ORDER BY id;
}
expect {
    1|20
    2|5
}

# DELETE rows with partial index containing BETWEEN
