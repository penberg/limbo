# Long lhs BETWEEN chain in partial-index predicate should not explode
# codegen with u16 overflow during INSERT.
@cross-check-integrity
test partial-index-long-between-chain {
    CREATE TABLE t_chain(x);
    CREATE INDEX i_chain ON t_chain(x) WHERE
      x BETWEEN 0 AND CASE WHEN 1 THEN 1 END
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0
      BETWEEN 0 AND 0;
    INSERT INTO t_chain VALUES(1);
    SELECT x FROM t_chain;
    PRAGMA integrity_check;
}
expect {
    1
    ok
}

# Query WHERE matches the index's compound WHERE exactly, plus an equality on
# the indexed column -> should seek the partial index.
@skip-if sqlite "query plan explanation output is different in sqlite"
test plan-partial-index-and-where-eq-seek {
    CREATE TABLE samples (id INTEGER PRIMARY KEY, library_id INTEGER, attack_score INTEGER, name TEXT);
    CREATE INDEX samples_pidx ON samples(name) WHERE library_id IS NULL AND attack_score IS NOT NULL;
    EXPLAIN QUERY PLAN
        SELECT name FROM samples
        WHERE library_id IS NULL AND attack_score IS NOT NULL AND name = 'foo';
}
expect {
    1|0|0|SEARCH samples USING INDEX samples_pidx (name=?)
}

@skip-if sqlite "query plan explanation output is different in sqlite"
test plan-partial-index-and-where-reversed-order {
    CREATE TABLE samples (id INTEGER PRIMARY KEY, library_id INTEGER, attack_score INTEGER, name TEXT);
    CREATE INDEX samples_pidx ON samples(name) WHERE library_id IS NULL AND attack_score IS NOT NULL;
    EXPLAIN QUERY PLAN
        SELECT name FROM samples
        WHERE attack_score IS NOT NULL AND library_id IS NULL AND name = 'foo';
}
expect {
    1|0|0|SEARCH samples USING INDEX samples_pidx (name=?)
}

# Partial index WHERE uses qualified column references; query references the same columns unqualified.
@skip-if sqlite "query plan explanation output is different in sqlite"
test plan-partial-index-qualified-where-matches {
